<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MaintManager.MAUI.ViewModels.Maintenances"
    x:Class="MaintManager.MAUI.Views.Maintenances.MaintenanceDetailPage"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource ColorBackground}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,8,0">
            <Label Grid.Column="0"
                   Text="{Binding Title}"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1"
                    Text="✕ Cancelar"
                    Command="{Binding CancelOrderCommand}"
                    IsVisible="{Binding CanCancel}"
                    BackgroundColor="#C62828"
                    TextColor="White"
                    FontSize="12" FontAttributes="Bold"
                    HeightRequest="32"
                    CornerRadius="6"
                    Padding="10,0"
                    VerticalOptions="Center"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="*,Auto">

        <!-- LOADING -->
        <VerticalStackLayout IsVisible="{Binding IsLoading}"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="True" Color="{StaticResource ColorPrimary}"/>
            <Label Text="Cargando detalle..." Style="{StaticResource BodyText}"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- ERROR -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
            <Label Text="⚠" FontSize="40" HorizontalOptions="Center"
                   TextColor="{StaticResource ColorError}"/>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            <Button Text="Reintentar" Command="{Binding LoadCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- SUCCESS -->
        <ScrollView IsVisible="{Binding IsSuccess}">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header: order number, vehicle, plate, status -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="14"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding MaintenanceDetail.OrderNumber}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 99"
                                Padding="10,4"
                                BackgroundColor="{StaticResource ColorInfoContainer}">
                            <Label Text="{Binding MaintenanceDetail.StatusName}"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorInfo}"/>
                        </Border>
                        <Label Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding MaintenanceDetail.VehicleName}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"
                               Margin="0,2,0,0"/>
                        <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="16"
                                               Margin="0,2,0,0">
                            <Label Text="{Binding MaintenanceDetail.LicensePlate, StringFormat='Placa: {0}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource ColorTextSecondary}"/>
                            <Label Text="{Binding MaintenanceDetail.Mileage, StringFormat='Km: {0:N0}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource ColorTextSecondary}"/>
                        </HorizontalStackLayout>
                        <Label Grid.Row="3" Grid.ColumnSpan="2"
                               FontSize="11" Margin="0,1,0,0"
                               TextColor="{StaticResource ColorTextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Aceite: "/>
                                    <Span Text="{Binding MaintenanceDetail.OilBrand}"/>
                                    <Span Text=" — "/>
                                    <Span Text="{Binding MaintenanceDetail.OilViscositySae}"/>
                                </FormattedString>
                            </Label.FormattedText>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding MaintenanceDetail.OilBrand}"
                                             Value="{x:Null}">
                                    <Setter Property="Text" Value="Sin información de aceite"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Border>

                <!-- Info General -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="12"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Información General"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              RowSpacing="6" ColumnSpacing="10"
                              HorizontalOptions="Start">
                            <Label Grid.Row="0" Grid.Column="0" Text="Tipo de Servicio:" Style="{StaticResource CaptionText}"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding MaintenanceDetail.MaintenanceType}"
                                   TextColor="{StaticResource ColorTextPrimary}"/>
                            <Label Grid.Row="1" Grid.Column="0" Text="Tipo de Mantenimiento:" Style="{StaticResource CaptionText}"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding MaintenanceDetail.ServiceType}"
                                   TextColor="{StaticResource ColorTextPrimary}"/>
                            <Label Grid.Row="2" Grid.Column="0" Text="Fecha:" Style="{StaticResource CaptionText}"/>
                            <Label Grid.Row="2" Grid.Column="1" TextColor="{StaticResource ColorTextPrimary}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding MaintenanceDetail.MaintenanceDate, StringFormat='{0:dd/MM/yyyy}'}"/>
                                        <Span Text="  "/>
                                        <Span Text="Hora: "/>
                                        <Span Text="{Binding MaintenanceDetail.MaintenanceDate, StringFormat='{0:HH:mm}'}" FontAttributes="Bold"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="3" Grid.Column="0" Text="Kilometraje:" Style="{StaticResource CaptionText}"/>
                            <Label Grid.Row="3" Grid.Column="1"
                                   Text="{Binding MaintenanceDetail.Mileage, StringFormat='{0:N0} km'}"
                                   TextColor="{StaticResource ColorTextPrimary}"/>
                            <Label Grid.Row="4" Grid.Column="0" Text="Técnico:" Style="{StaticResource CaptionText}"/>
                            <Label Grid.Row="4" Grid.Column="1"
                                   Text="{Binding MaintenanceDetail.AssignedToName}"
                                   TextColor="{StaticResource ColorTextPrimary}"/>
                            <Label Grid.Row="5" Grid.Column="0" Text="Origen:" Style="{StaticResource CaptionText}"/>
                            <Label Grid.Row="5" Grid.Column="1"
                                   Text="{Binding MaintenanceDetail.OriginService}"
                                   TextColor="{StaticResource ColorTextPrimary}"/>
                        </Grid>
                        <Button Text="Ver historial completo del vehículo"
                                Command="{Binding ViewVehicleHistoryCommand}"
                                FontSize="12" HeightRequest="34" Padding="10,0"
                                BackgroundColor="{StaticResource ColorInfoContainer}"
                                TextColor="{StaticResource ColorPrimary}"
                                HorizontalOptions="Start" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- ACCIONES — Checklist -->
                <!-- ═══════════════════════════════════════════════ -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="12"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Acciones Realizadas"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorderLight}"/>

                        <CollectionView ItemsSource="{Binding ActionChecklist}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActionChecklistItem">
                                    <Grid ColumnDefinitions="36,*,36" Padding="0,3" ColumnSpacing="6">
                                        <!-- Edit mode: RadioButton "Sí" -->
                                        <RadioButton GroupName="{Binding GroupKey}"
                                                     IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                     IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                                                     VerticalOptions="Center"/>
                                        <!-- ReadOnly mode: Status icon -->
                                        <Label Text="{Binding StatusIcon}" FontSize="14"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly}"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource ColorTextPrimary}"/>
                                            <Label Text="{Binding Detail}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource ColorTextSecondary}"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding Detail, Converter={StaticResource IsNotNullConverter}}"/>
                                        </VerticalStackLayout>

                                        <!-- Edit mode: RadioButton "No" -->
                                        <RadioButton Grid.Column="2"
                                                     GroupName="{Binding GroupKey}"
                                                     IsChecked="{Binding IsNotDone, Mode=TwoWay}"
                                                     IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                                                     VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No hay acciones configuradas para este vehículo."
                                       Style="{StaticResource CaptionText}" Margin="0,8"/>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <!-- Column headers: solo en modo edición -->
                        <Grid ColumnDefinitions="36,*,36" Padding="0,0,0,4"
                              IsVisible="{Binding IsReadOnly, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Grid.Column="0" Text="Sí" FontSize="10"
                                   TextColor="{StaticResource ColorTextSecondary}"
                                   HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="No" FontSize="10"
                                   TextColor="{StaticResource ColorTextSecondary}"
                                   HorizontalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- MATERIALES — Checklist -->
                <!-- ═══════════════════════════════════════════════ -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="12"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Materiales a Consumir"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorderLight}"/>

                        <CollectionView ItemsSource="{Binding MaterialChecklist}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MaterialChecklistItem">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="36,*,36" Padding="0,3" ColumnSpacing="6">
                                            <!-- Edit mode: RadioButton "Sí" -->
                                            <RadioButton GroupName="{Binding GroupKey}"
                                                         IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                                                         VerticalOptions="Center"/>
                                            <!-- ReadOnly mode: StatusDetail -->
                                            <Label Text="{Binding StatusDetail}" FontSize="12"
                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>

                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{StaticResource ColorTextPrimary}"/>
                                                <Label Text="{Binding Detail, StringFormat='Unidad: {0}'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource ColorTextSecondary}"/>
                                            </VerticalStackLayout>

                                            <!-- Edit mode: RadioButton "No" -->
                                            <RadioButton Grid.Column="2"
                                                         GroupName="{Binding GroupKey}"
                                                         IsChecked="{Binding IsNotDone, Mode=TwoWay}"
                                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                                                         VerticalOptions="Center"/>
                                        </Grid>
                                        <!-- Quantity input: visible solo cuando "Usado" en modo edición -->
                                        <Border IsVisible="{Binding IsDone}"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="{StaticResource ColorBorder}"
                                                StrokeThickness="1" Padding="8,0"
                                                Margin="36,0,36,4" HeightRequest="36"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}">
                                            <Entry Text="{Binding Quantity, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   Placeholder="Cantidad"
                                                   FontSize="12"
                                                   TextColor="{StaticResource ColorTextPrimary}"
                                                   PlaceholderColor="{StaticResource Gray500}"/>
                                        </Border>
                                        <!-- Stock note -->
                                        <Label Text="{Binding StockNote}"
                                               FontSize="11"
                                               TextColor="{StaticResource ColorInfo}"
                                               Margin="36,0,36,0"
                                               IsVisible="{Binding StockNote, Converter={StaticResource IsNotNullConverter}}"/>
                                        <!-- Origin picker -->
                                        <Border IsVisible="{Binding IsDone}"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="{StaticResource ColorBorder}"
                                                StrokeThickness="1" Padding="4,0"
                                                Margin="36,0,36,4" HeightRequest="36"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}">
                                            <Picker ItemsSource="{Binding OriginOptions}"
                                                    SelectedItem="{Binding Origin, Mode=TwoWay}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource ColorTextPrimary}"
                                                    Title="Origen"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No hay materiales configurados para este vehículo."
                                       Style="{StaticResource CaptionText}" Margin="0,8"/>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <Grid ColumnDefinitions="36,*,36" Padding="0,0,0,4"
                              IsVisible="{Binding IsReadOnly, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Grid.Column="0" Text="Sí" FontSize="10"
                                   TextColor="{StaticResource ColorTextSecondary}"
                                   HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="No" FontSize="10"
                                   TextColor="{StaticResource ColorTextSecondary}"
                                   HorizontalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- COMPONENTES — Checklist -->
                <!-- ═══════════════════════════════════════════════ -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="12"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Componentes a Instalar"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorderLight}"/>

                        <CollectionView ItemsSource="{Binding ComponentChecklist}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComponentChecklistItem">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="36,*,36" Padding="0,3" ColumnSpacing="6">
                                            <!-- Edit mode: RadioButton "Sí" -->
                                            <RadioButton GroupName="{Binding GroupKey}"
                                                         IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                                                         VerticalOptions="Center"/>
                                            <!-- ReadOnly mode: StatusDetail -->
                                            <Label Text="{Binding StatusDetail}" FontSize="12"
                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>

                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{StaticResource ColorTextPrimary}"/>
                                                <Label Text="{Binding Detail}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource ColorTextSecondary}"
                                                       LineBreakMode="WordWrap"
                                                       IsVisible="{Binding Detail, Converter={StaticResource IsNotNullConverter}}"/>
                                            </VerticalStackLayout>

                                            <!-- Edit mode: RadioButton "No" -->
                                            <RadioButton Grid.Column="2"
                                                         GroupName="{Binding GroupKey}"
                                                         IsChecked="{Binding IsNotDone, Mode=TwoWay}"
                                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                                                         VerticalOptions="Center"/>
                                        </Grid>
                                        <!-- Quantity input: visible cuando "Instalado" en modo edición -->
                                        <Border IsVisible="{Binding IsDone}"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="{StaticResource ColorBorder}"
                                                StrokeThickness="1" Padding="8,0"
                                                Margin="36,0,36,4" HeightRequest="36"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}">
                                            <Entry Text="{Binding Quantity, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   Placeholder="Cantidad"
                                                   FontSize="12"
                                                   TextColor="{StaticResource ColorTextPrimary}"
                                                   PlaceholderColor="{StaticResource Gray500}"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No hay componentes configurados para este vehículo."
                                       Style="{StaticResource CaptionText}" Margin="0,8"/>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <Grid ColumnDefinitions="36,*,36" Padding="0,0,0,4"
                              IsVisible="{Binding IsReadOnly, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Grid.Column="0" Text="Sí" FontSize="10"
                                   TextColor="{StaticResource ColorTextSecondary}"
                                   HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="No" FontSize="10"
                                   TextColor="{StaticResource ColorTextSecondary}"
                                   HorizontalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Reasignar Técnico (solo Admin, solo en orden activa) -->
                <Border IsVisible="{Binding IsAdmin}"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="16"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <VerticalStackLayout Spacing="8"
                                         IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Reasignar Técnico"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorderLight}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource ColorBorder}"
                                StrokeThickness="1" Padding="4,0">
                            <Picker ItemsSource="{Binding Technicians}"
                                    SelectedItem="{Binding SelectedTechnician}"
                                    ItemDisplayBinding="{Binding FullName}"
                                    Title="Seleccionar técnico..."
                                    Style="{StaticResource FormPicker}"/>
                        </Border>
                        <Button Text="Asignar"
                                Command="{Binding AssignTechnicianCommand}"
                                Style="{StaticResource AccentButton}"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Diagnóstico (display when exists) -->
                <Border IsVisible="{Binding Diagnosis, Converter={StaticResource IsNotNullConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="16"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Diagnóstico"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorderLight}"/>
                        <Label Text="{Binding Diagnosis.GeneralStatus, StringFormat='Estado general: {0}'}"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <Label Text="{Binding Diagnosis.VehicleOperative, StringFormat='Vehículo operativo: {0}'}"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <Label Text="Observaciones:" Style="{StaticResource CaptionText}"
                               IsVisible="{Binding Diagnosis.Observations, Converter={StaticResource IsNotNullConverter}}"/>
                        <Label Text="{Binding Diagnosis.Observations}"
                               TextColor="{StaticResource ColorTextPrimary}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding Diagnosis.Observations, Converter={StaticResource IsNotNullConverter}}"/>
                        <Label Text="Recomendaciones futuras:" Style="{StaticResource CaptionText}"
                               IsVisible="{Binding Diagnosis.FutureRecommendations, Converter={StaticResource IsNotNullConverter}}"/>
                        <Label Text="{Binding Diagnosis.FutureRecommendations}"
                               TextColor="{StaticResource ColorTextPrimary}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding Diagnosis.FutureRecommendations, Converter={StaticResource IsNotNullConverter}}"/>
                        <Label Text="{Binding Diagnosis.CreatedAt, StringFormat='Diagnosticado el: {0:dd/MM/yyyy HH:mm}'}"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Diagnosis form (when not yet saved and not read-only) -->
                <Border IsVisible="{Binding DiagnosisSaved, Converter={StaticResource InvertedBoolConverter}}"
                        IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenanceDetailViewModel}}, Path=IsReadOnly, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource ColorBorderLight}"
                        StrokeThickness="1" Padding="16"
                        BackgroundColor="{StaticResource ColorSurface}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Registrar Diagnóstico"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorderLight}"/>
                        <Label Text="Estado general del vehículo:" Style="{StaticResource CaptionText}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource ColorBorder}"
                                StrokeThickness="1" Padding="4,0">
                            <Picker ItemsSource="{Binding GeneralStatusOptions}"
                                    SelectedItem="{Binding SelectedGeneralStatus}"
                                    Title="Seleccionar estado..."
                                    Style="{StaticResource FormPicker}"/>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Text="Vehículo operativo:" VerticalOptions="Center"
                                   Style="{StaticResource CaptionText}"/>
                            <Switch Grid.Column="1" IsToggled="{Binding IsVehicleOperative}"
                                    OnColor="{StaticResource ColorSuccess}"
                                    ThumbColor="{StaticResource ColorPrimary}"/>
                        </Grid>
                        <Label Text="Observaciones del mecánico:" Style="{StaticResource CaptionText}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource ColorBorder}"
                                StrokeThickness="1" Padding="12,4">
                            <Editor Text="{Binding DiagnosisObservations}"
                                    HeightRequest="100"
                                    Placeholder="Describe el estado del vehículo, problemas encontrados, etc."
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    PlaceholderColor="{StaticResource Gray500}"/>
                        </Border>
                        <Label Text="Recomendaciones para próximos servicios:" Style="{StaticResource CaptionText}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource ColorBorder}"
                                StrokeThickness="1" Padding="12,4">
                            <Editor Text="{Binding FutureRecommendations}"
                                    HeightRequest="80"
                                    Placeholder="Ej: Revisar correa de distribución en 10000 km"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    PlaceholderColor="{StaticResource Gray500}"/>
                        </Border>
                        <Button Text="Guardar Diagnóstico"
                                Command="{Binding SaveDiagnosisCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="16,8,16,16">

            <Button Grid.Column="0"
                    Text="Cerrar Orden"
                    Command="{Binding CloseOrderCommand}"
                    IsVisible="{Binding CanClose}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalOptions="Fill"/>

            <Button Grid.Column="1"
                    Text=" Exportar PDF"
                    Command="{Binding ExportPdfCommand}"
                    IsVisible="{Binding IsReadOnly}"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="12"
                    HorizontalOptions="Fill"/>

        </Grid>
    </Grid>
</ContentPage>
